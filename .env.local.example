# Copy this file to .env.local and adjust values for local or Codespace development.
# .env.local is git-ignored — never commit it.

# Your GitHub username. Used to fetch the profile README for the homepage bio.
# Defaults to "adamsuk" if not set.
NEXT_PUBLIC_GITHUB_PROFILE=adamsuk

# URL of the headless CMS API for blog posts and CV content.
# Defaults to https://blog.sradams.co.uk/api if not set.
#
# CORS NOTE (Codespaces): The production CMS at blog.sradams.co.uk does not
# allow requests from *.app.github.dev preview URLs. Blog and CV content will
# fail to load in the Codespace browser preview until one of:
#   1. The Codespace origin is added to the CMS CORS allowed-origins list.
#   2. A local or staging CMS instance is used instead.
#   3. A Next.js rewrites()-based proxy is added to next.config.js
#      (works during `next dev` only — the project uses static export for builds).
NEXT_PUBLIC_CMS_URL=https://blog.sradams.co.uk/api

# Better Stack error tracking DSN (Sentry-compatible). Copy it from the app's
# Ingest tab in Better Stack. Leave unset to disable the SDK (the default for
# local dev, tests and e2e). Never commit the real value.
# In production this must be set as the GitHub Actions repository secret
# NEXT_PUBLIC_SENTRY_DSN — the site is statically exported in CI, so Cloudflare
# Pages environment variables are not applied to the client bundle.
# NEXT_PUBLIC_SENTRY_DSN=
# Optional event label. The deploy workflow sets this to `preview` or
# `production`. Locally it falls back to NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional release name. The deploy workflow sets this from the git commit
# SHA so it matches the source maps uploaded to Better Stack. Leave unset
# locally. Never put a token or DSN here.
# NEXT_PUBLIC_SENTRY_RELEASE=

# Better Stack real-user monitoring (web vitals, analytics, session replay
# and front-end errors). Public client-side token. Leave unset to render
# nothing (local dev, tests and e2e). Never commit a real token.
# Set the GitHub Actions repository variable (not a secret)
# NEXT_PUBLIC_BETTERSTACK_RUM_TOKEN. It is inlined at build time.
# Research Scout / Scott will set that variable.
# NEXT_PUBLIC_BETTERSTACK_RUM_TOKEN=
